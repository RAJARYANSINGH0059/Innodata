{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/innodata/task-package-0.1.0.schema.json",
  "title": "Internal Coding Task Package",
  "description": "Provisional Phase 1 schema. Not an Innodata-organiser submission schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "task_kind", "repository", "requirements", "reference", "tests", "provenance"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "task_id": {"type": "string", "minLength": 1},
    "task_kind": {"enum": ["feature", "feature_extension"]},
    "title": {"type": "string", "minLength": 8},
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "base_commit", "git_tree", "working_tree_digest", "license"],
      "properties": {
        "uri": {"type": "string", "format": "uri"},
        "base_commit": {"type": "string", "minLength": 7},
        "git_tree": {"type": "string", "minLength": 7},
        "working_tree_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "license": {"type": "string", "minLength": 1},
        "runtime": {"type": "string"},
        "environment_digest": {"type": "string"}
      }
    },
    "requirements": {
      "type": "object",
      "required": ["problem", "acceptance_criteria", "non_goals", "invariants"],
      "properties": {
        "problem": {"type": "string", "minLength": 20},
        "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "statement"], "properties": {"id": {"type": "string"}, "statement": {"type": "string", "minLength": 5}, "requirement_ids": {"type": "array", "items": {"type": "string"}}}}},
        "non_goals": {"type": "array", "items": {"type": "string"}},
        "invariants": {"type": "array", "items": {"type": "string"}},
        "inputs_outputs": {"type": "array", "items": {"type": "object"}},
        "edge_cases": {"type": "array", "items": {"type": "string"}},
        "affected_symbols": {"type": "array", "items": {"type": "string"}}
      }
    },
    "reference": {
      "type": "object",
      "required": ["patch_path", "patch_sha256"],
      "properties": {
        "patch_path": {"type": "string"},
        "patch_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "tests": {
      "type": "object",
      "required": ["feature", "regression", "traceability"],
      "properties": {
        "feature": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "regression": {"type": "array", "items": {"type": "string"}},
        "traceability": {"type": "array", "items": {"type": "object", "required": ["criterion_id", "test_ids"], "properties": {"criterion_id": {"type": "string"}, "test_ids": {"type": "array", "items": {"type": "string"}}}}}
      }
    },
    "provenance": {
      "type": "object",
      "required": ["generation_method", "prompt_version", "manual_interventions"],
      "properties": {
        "generation_method": {"type": "string"},
        "model": {"type": "string"},
        "prompt_version": {"type": "string"},
        "seed": {"type": ["integer", "null"]},
        "manual_interventions": {"type": "array", "items": {"type": "object"}}
      }
    }
  }
}
